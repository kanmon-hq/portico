# ═══════════════════════════════════════════════════════════════════════
#  Portico — Environment Variables
# ═══════════════════════════════════════════════════════════════════════

# ── Gateway & PoC Controls ───────────────────────────────────────────
# true  → log tool calls without hitting real SaaS APIs (safe for demos)
# false → call real Slack / Google APIs
MOCK_EXTERNAL_APIS=true
LOG_LEVEL=INFO

# ── Authentication & Security (Kura 準拠) ─────────────────────────
# ゲートウェイ共有シークレット (X-Gateway-Secret, 32文字以上, 本番必須)
# GATEWAY_SHARED_SECRET="a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef0"
# シークレットローテーション移行期間用の旧シークレット
# GATEWAY_SHARED_SECRET_PREVIOUS="previous_secret_32_chars_long_here_000000000"
# シークレット受信用ヘッダー名 (既定: X-Gateway-Secret)
# GATEWAY_SECRET_HEADER=X-Gateway-Secret
# 開発・検証専用 (シークレット検証をバイパス)
INSECURE_NO_GATEWAY_AUTH=true

# 内部サービス専用 API の Bearer 認証キー (未設定時は内部 API 無効)
# INTERNAL_API_KEY="internal_secret_key_32_chars_long_example_000"

# ── Master Storage (Zero-Ops / Multi-Cloud) ─────────────────────────
# sqlite (既定) | dynamodb (AWS) | firestore (GCP) | cosmosdb (Azure)
STORAGE_BACKEND=sqlite

# SQLite 設定 (STORAGE_BACKEND=sqlite 時)
SQLITE_DB_PATH=portico.db

# AWS DynamoDB 設定 (STORAGE_BACKEND=dynamodb 時)
# DYNAMODB_TABLE_NAME=portico_servers
# AWS_REGION=ap-northeast-1
# DYNAMODB_ENDPOINT=http://localhost:8000  # ローカル DynamoDB Local 利用時

# GCP Firestore 設定 (STORAGE_BACKEND=firestore 時)
# FIRESTORE_COLLECTION=portico_servers
# GCP_PROJECT_ID=my-gcp-project

# Azure Cosmos DB 設定 (STORAGE_BACKEND=cosmosdb 時)
# COSMOS_ENDPOINT=https://my-cosmos.documents.azure.com:443/
# COSMOS_KEY=my-cosmos-primary-key
# COSMOS_DATABASE=portico_db
# COSMOS_CONTAINER=portico_servers

# ── Two-Tier Cache (L1: In-Memory + L2: Valkey/Redis) ─────────────────
# two_tier (既定: L1+L2) | memory (L1のみ) | valkey (L2のみ) | none (無効)
CACHE_LAYER=memory
CACHE_L1_TTL_SECONDS=30
CACHE_L1_MAXSIZE=1000
CACHE_L2_TTL_SECONDS=300
VALKEY_URL=redis://localhost:6379/0

# ── Security & Encryption ─────────────────────────────────────────────
# 外部 MCP サーバー認証情報暗号化マスターキー (AES-256-GCM, 本番必須)
# SECRET_ENCRYPTION_KEY="your_secret_encryption_key_32_chars_here_000"

# ── Gateway Control & Performance Tuning ─────────────────────────────
# DEFAULT_TENANT_ID=tenant_default
# ALLOW_LOCAL_MCP_SERVERS=true
# ROOT_PATH=/gateway
# OPENAPI_URL=/openapi.json
# DOCS_URL=/docs
# REDOC_URL=/redoc
# SCALAR_URL=/scalar
# MAX_SERVERS_PER_TENANT=50
# TOOL_CACHE_TTL_SECONDS=60
# EXTERNAL_MCP_TIMEOUT_SECONDS=5.0
